# Copy to .env and fill in before running docker-compose up
JWT_SECRET=replace-with-a-long-random-256-bit-string

# local = save resumes to disk (no AWS needed, good for dev)
# s3    = save resumes to the S3 bucket below (use in production)
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_S3_BUCKET=ai-job-portal-resumes
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AI_PROVIDER_URL=https://api.anthropic.com/v1/messages
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
